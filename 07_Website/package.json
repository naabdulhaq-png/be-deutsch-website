{
  "name": "be-deutsch-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "assets:generate": "node scripts/generate-web-assets.mjs",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check:site": "node scripts/check-site.mjs",
    "preflight:production": "node scripts/check-legal-readiness.mjs",
    "build:release-candidate": "pnpm preflight:production && astro check && astro build && pnpm check:site && pnpm check:vocabulary && pnpm check:quiz-sounds && pnpm check:listening && pnpm check:grammar && pnpm check:ui08 && pnpm check:audio-integration && pnpm test:release-gate && pnpm prepare:public-artifact && pnpm check:public-artifact",
    "build:production": "pnpm check:deployment-authorization && pnpm build:release-candidate",
    "preview": "astro preview",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:quiz-sounds": "node scripts/check-quiz-sounds.mjs",
    "check:listening": "node scripts/check-listening.mjs",
    "check:grammar": "node scripts/check-grammar.mjs",
    "check:a2-release": "pnpm test:release-gate && pnpm check:public-artifact",
    "test:release-gate": "node --test tests/release-route-contract.test.mjs",
    "prepare:public-artifact": "node scripts/prepare-public-artifact.mjs",
    "check:public-artifact": "node scripts/check-a2-release.mjs",
    "check:deployment-authorization": "node scripts/check-deployment-authorization.mjs",
    "capture:bd-ui03": "node scripts/capture-bd-ui03.mjs",
    "manifest:bd-ui03": "node scripts/generate-bd-ui03-release.mjs",
    "integrate:a2": "node scripts/build-a2-integration.mjs",
    "check:ui08": "node scripts/check-bd-ui08.mjs",
    "capture:ui08": "node scripts/capture-bd-ui08.mjs",
    "deliverables:ui08": "node scripts/generate-bd-ui08-deliverables.mjs",
    "check:ui08-browser": "node scripts/check-bd-ui08-browser.mjs",
    "check:audio-integration": "node scripts/check-bd-ui08-audio-integration.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
