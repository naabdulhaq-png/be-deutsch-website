---
import Hint from './Hint.astro';
import { hintLibrary } from '../i18n/support';
interface Props { title: string; rows: string[][] }
const { title, rows } = Astro.props;
function hintFor(row: string[]) {
  if (title.toLowerCase().includes('podcast')) return hintLibrary.podcast;
  if (row[0].startsWith('G01')) return hintLibrary.grammarVerbParts;
  return hintLibrary.vocabulary;
}
---
<section class="practice"><h2>{title}</h2><p class="muted">Learning practice · self-check only · no automatic score</p>
{rows.map((row,index)=>{const hint=hintFor(row);return <article class="practice-item"><p class="eyebrow">Activity {index+1}</p><h3>{row[1]}</h3>{index===0&&<Hint id={row[0]} first={hint.first} second={hint.second}/>}<textarea aria-label={`Your practice notes for activity ${index+1}`} data-note={row[0]} rows="3" placeholder="Try it aloud or write your response here. Notes stay in this tab only."></textarea><details><summary>Compare with the model and self-check</summary><p>{row[2]}</p>{row[3]&&<p>{row[3]}</p>}</details><label class="checkline"><input type="checkbox" data-practice={row[0]} /> I tried this and checked the model</label></article>})}
</section>
