---
import type { AudioAsset } from '../lib/model';
interface Props { asset: AudioAsset; label?: string }
const { asset, label = 'Listen' } = Astro.props;
const mins = Math.floor(asset.duration/60), secs = Math.floor(asset.duration%60).toString().padStart(2,'0');
const actionLabel = label.replace(/^Play\s+/i, '');
---
<div class="audio-player" data-audio-id={asset.id}>
  <p class="audio-caption"><strong>{label}</strong> <span>{mins}:{secs} · {asset.voices.map(v=>v.voice).filter((v,i,a)=>a.indexOf(v)===i).join(' / ')}</span></p>
  <audio controls preload="metadata" src={asset.url} aria-label={actionLabel} data-asset-id={asset.id} data-duration={asset.duration}></audio>
  <div class="audio-actions"><button type="button" class="quiet play-audio">Play {actionLabel}</button><button type="button" class="quiet restart-audio">Restart</button><label class="audio-speed-label">Speed <select class="audio-speed" aria-label={`Playback speed for ${actionLabel}`}><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option></select></label></div>
  <p class="audio-status muted" role="status">Ready to play. Progress is saved on this browser.</p>
  <button type="button" class="quiet resume-audio" hidden>Resume saved position</button>
</div>
