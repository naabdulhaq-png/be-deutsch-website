---
import logo from '../../assets/branding/be_deutsch_ring_mark.svg';
import a2 from '../../a2/data/course.json';
import integratedCourse from '../../a2/data/integrated-course.json';
import vocabularyA1 from '../../data/vocabulary-course.json';
import listeningA1 from '../../data/listening-course.json';
import { grammarLessons } from '../../data/grammar-course';
import '../../styles/bd-ui-02.css';
import '../../styles/bd-ui-07.css';
import '../../styles/design-3.css';

interface Props {
  area: 'vocabulary' | 'grammar' | 'listening' | 'podcast' | 'overview';
  level?: 'A1' | 'A2';
  title?: string;
}

const { area, level = 'A1', title = 'Learning workspace' } = Astro.props;
const path = Astro.url.pathname;
const categoryMeta = {
  vocabulary: { label: 'Vocabulary', icon: '▤', tone: 'sky' },
  grammar: { label: 'Grammar', icon: '◆', tone: 'violet' },
  listening: { label: 'Listening', icon: '◉', tone: 'mint' },
  podcast: { label: 'Podcast', icon: '◍', tone: 'orange' },
};
const a2Groups = [
  { id: 'vocabulary', href: '/a2/unit-1/vocabulary/v01/', items: a2.vocabulary.map((item) => ({ id: item.id, label: item.title, href: `/a2/unit-1/vocabulary/${item.id.slice(-3).toLowerCase()}/` })) },
  { id: 'grammar', href: '/a2/unit-1/grammar/g01/', items: a2.grammar.map((item) => ({ id: item.id, label: item.title, href: `/a2/unit-1/grammar/${item.id.slice(-3).toLowerCase()}/` })) },
  { id: 'listening', href: '/a2/unit-1/listening/l01/', items: [
    { id: 'A2-U01-L01', label: 'Weekend Update', href: '/a2/unit-1/listening/l01/' },
    { id: 'A2-U01-L02', label: 'A Short Experience Story', href: '/a2/unit-1/listening/l02/' },
  ] },
  { id: 'podcast', href: '/a2/unit-1/podcast/', items: [{ id: 'A2-P01', label: a2.podcast.title, href: '/a2/unit-1/podcast/' }] },
];
const a1Groups = [
  { id: 'vocabulary', href: '/vocabulary/', items: vocabularyA1.lessons.map((item) => ({ id: item.lesson_id, label: item.title_de, href: `/vocabulary/lesson-${String(item.number).padStart(2, '0')}/` })) },
  { id: 'grammar', href: '/grammar/', items: grammarLessons.map((item) => ({ id: `A1-G-${item.number}`, label: item.title, href: `/grammar/lesson-${String(item.number).padStart(2, '0')}/` })) },
  { id: 'listening', href: '/listening/', items: listeningA1.lessons.map((item) => ({ id: item.id, label: item.title, href: `/listening/${item.id.toLowerCase()}/` })) },
  { id: 'podcast', href: '/podcasts/', items: [{ id: 'P01', label: 'Ein Morgen in Deutschland', href: '/podcasts/ein-morgen/' }] },
];
const groups = level === 'A2' ? a2Groups : a1Groups;
const searchIndex = [
  ...grammarLessons.map((item) => ({ title: item.title, meta: `A1 Grammar · Unit ${item.unit}`, href: `/grammar/lesson-${String(item.number).padStart(2, '0')}/` })),
  ...vocabularyA1.lessons.map((item) => ({ title: item.title_de, meta: `A1 Vocabulary · Lesson ${item.number}`, href: `/vocabulary/lesson-${String(item.number).padStart(2, '0')}/` })),
  ...listeningA1.lessons.map((item) => ({ title: item.title, meta: `A1 Listening · ${item.id}`, href: `/listening/${item.id.toLowerCase()}/` })),
  ...a2.grammar.map((item) => ({ title: item.title, meta: 'A2 Unit 1 · Grammar', href: `/a2/unit-1/grammar/${item.id.slice(-3).toLowerCase()}/` })),
  ...a2.vocabulary.map((item) => ({ title: item.title, meta: 'A2 Unit 1 · Vocabulary', href: `/a2/unit-1/vocabulary/${item.id.slice(-3).toLowerCase()}/` })),
  ...a2.lexical.map((item) => ({ title: item.headword, meta: `${item.meaning_en} · A2 Unit 1`, href: `/a2/unit-1/vocabulary/${item.lesson_id.slice(-3).toLowerCase()}/#${item.lexical_id}` })),
  { title: a2.podcast.title, meta: 'A2 Unit 1 · Podcast', href: '/a2/unit-1/podcast/' },
  ...integratedCourse.grammar.filter((item) => item.unit > 1).map((item) => ({ title: item.title, meta: `A2 Unit ${item.unit} · Grammar`, href: `/a2/unit-${item.unit}/grammar/${item.id.slice(-3).toLowerCase()}/` })),
  ...integratedCourse.vocabulary.filter((item) => item.unit > 1).map((item) => ({ title: item.german.display, meta: `${item.meaning.en} · A2 Unit ${item.unit}`, href: `/a2/unit-${item.unit}/vocabulary/${item.lesson_id.slice(-3).toLowerCase()}/#${item.id}` })),
  ...integratedCourse.listening.filter((item) => item.unit > 1).map((item) => ({ title: item.title_de, meta: `A2 Unit ${item.unit} · Listening`, href: `/a2/unit-${item.unit}/listening/${item.lesson_id.slice(-3).toLowerCase()}/#${item.id}` })),
  ...integratedCourse.podcasts.filter((item) => !item.unit_placement.includes(1)).map((item) => ({ title: item.title_de, meta: `A2 Unit ${item.unit_placement[0]} · Podcast`, href: `/a2/unit-${item.unit_placement[0]}/podcast/${item.blueprint_ref.toLowerCase()}/` })),
];
---

<div class="bd-ui02 bd-ui07" data-bd-ui02 data-area={area} data-level={level} data-search-index={JSON.stringify(searchIndex)}>
  <aside class="bd-ui02__sidebar bd-ui07__sidebar" id="bd-course-drawer" aria-label={`${level} course navigation`}>
    <div class="bd-ui02__brand"><a href="/" aria-label="Be Deutsch home"><img src={logo.src} alt="Be Deutsch" /></a><button type="button" data-bd-drawer-close aria-label="Close course outline">×</button></div>
    <div class="bd-ui07__course-heading">
      <span class:list={['bd-ui02__level', level === 'A1' && 'is-a1']}>{level}</span>
      <div><strong>{level === 'A2' ? 'A2 Complete Course' : 'A1 Foundations'}</strong><small>{level === 'A2' ? 'Unit 1 · Life updates' : 'Vocabulary · Grammar · Listening'}</small></div>
    </div>
    <nav class="bd-ui07__category-cards" aria-label="Learning sections">
      {groups.map((group) => {
        const meta = categoryMeta[group.id as keyof typeof categoryMeta];
        const active = group.id === area;
        return <details class:list={['bd-ui07__category', `is-${meta.tone}`, active && 'is-active']} open={active}>
          <summary aria-label={`${meta.label}: ${group.items.length} lessons`}><span class="bd-ui07__category-icon" aria-hidden="true">{meta.icon}</span><strong>{meta.label}</strong><small>{group.items.length}</small><span class="bd-ui07__chevron" aria-hidden="true">⌄</span></summary>
          <ol>{group.items.map((item, index) => <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined} data-nav-id={item.id}><span>{index + 1}</span><b>{item.label}</b><i data-nav-completion={item.id} aria-label=""></i></a></li>)}</ol>
          <a class="bd-ui02__all" href={group.href}>Open {meta.label.toLowerCase()}</a>
        </details>;
      })}
    </nav>
    <nav class="bd-ui07__utilities" aria-label="Course review and assessment">
      {level === 'A2' ? <>
        <a href="/a2/" aria-current={path === '/a2/' ? 'page' : undefined}><span aria-hidden="true">⌂</span>All A2 units</a>
        <a href="/a2/unit-1/revision/" aria-current={path === '/a2/unit-1/revision/' ? 'page' : undefined}><span aria-hidden="true">↻</span>Revision</a>
        <a href="/a2/unit-1/review/" aria-current={path === '/a2/unit-1/review/' ? 'page' : undefined}><span aria-hidden="true">✓</span>Assessment</a>
      </> : <a href="/testing/"><span aria-hidden="true">✓</span>Practice and tests</a>}
    </nav>
    {level === 'A2' && <label class="bd-ui02__unit-switch"><span>Choose A2 unit</span><select data-bd-course-switch aria-label="Switch A2 unit">{integratedCourse.units.map((item) => <option value={`/a2/unit-${item.unit}/`} selected={item.unit === 1}>Unit {item.unit} · {item.title}</option>)}</select></label>}
    <a class="bd-ui02__switch-link" href={level === 'A2' ? '/vocabulary/' : '/a2/'}>{level === 'A2' ? 'Open A1 Foundations' : 'Open A2 Complete Course'} →</a>
    {level === 'A2' && <p class="bd-ui02__note">All ten approved A2 units are available from the course overview and unit selector.</p>}
  </aside>
  <div class="bd-ui02__backdrop" data-bd-drawer-close hidden></div>
  <header class="bd-ui02__topbar bd-ui07__topbar">
    <button type="button" class="bd-ui02__menu" data-bd-drawer-open aria-controls="bd-course-drawer" aria-expanded="false">☰ <span>Course</span></button>
    <div class="bd-ui02__search"><span aria-hidden="true">⌕</span><label class="bd-ui02__sr" for="bd-course-search">Search lessons, topics or words</label><input id="bd-course-search" type="search" placeholder="Search lessons, topics or words…" autocomplete="off" aria-controls="bd-search-results" aria-expanded="false"/><div id="bd-search-results" class="bd-ui02__results" role="listbox" hidden></div></div>
    <div class="bd-ui02__context"><small>Current lesson</small><strong>{title}</strong></div>
    <label class="bd-ui02__course"><span>Course</span><select data-bd-course-switch aria-label="Switch course level"><option value="/grammar/" selected={level === 'A1'}>A1 · Foundations</option><option value="/a2/" selected={level === 'A2'}>A2 · Complete course</option></select></label>
    <a class="bd-ui02__home" href={level === 'A2' ? '/a2/' : '/'} aria-label={level === 'A2' ? 'A2 course overview' : 'Website home'}><img src={logo.src} width="48" height="48" alt=""/></a>
  </header>
</div>
<script>import '../../scripts/bd-ui-02';</script>
<style>
  .bd-ui02__unit-switch{display:grid;gap:.35rem;margin:.75rem 1rem;padding:.75rem;border:1px solid #d8dee8;border-radius:.7rem;background:#fff}
  .bd-ui02__unit-switch span{font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#667085}
  .bd-ui02__unit-switch select{max-inline-size:100%;padding:.55rem;border:1px solid #b8c1cf;border-radius:.45rem;background:#fff;color:#1f2937}
</style>
