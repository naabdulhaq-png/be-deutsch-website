---
import brandMark from '../assets/branding/be_deutsch_ring_mark.svg';
const currentPath = Astro.url.pathname;
const isA2 = currentPath.startsWith('/a2/');
const active = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
const learn = isA2 ? [
  { label: 'Vocabulary', href: '/a2/unit-1/vocabulary/v01/' }, { label: 'Grammar', href: '/a2/unit-1/grammar/g01/' },
  { label: 'Listening', href: '/a2/unit-1/listening/l01/' }, { label: 'Podcasts', href: '/a2/unit-1/podcast/' },
] : [
  { label: 'Vocabulary', href: '/vocabulary/' }, { label: 'Grammar', href: '/grammar/' },
  { label: 'Listening', href: '/listening/' }, { label: 'Podcasts', href: '/podcasts/' },
];
---
<header class="site-header d3-header">
 <div class="container site-header__inner">
  <a class="d3-brand" href="/" aria-label="Be Deutsch homepage"><img src={brandMark.src} width="64" height="64" alt=""/><span><strong>Be Deutsch</strong><small>Learn German, step by step.</small></span></a>
  <nav class="desktop-nav d3-nav" aria-label="Main navigation">
   <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
   <details class="nav-dropdown" data-active={active('/a2/') || active('/vocabulary/') || active('/grammar/') || active('/listening/') || active('/podcasts/') ? 'true' : undefined}><summary>Courses <span aria-hidden="true">⌄</span></summary><div class="nav-dropdown__menu d3-course-menu"><a href="/vocabulary/"><b>A1 Foundations</b><small>Vocabulary, grammar, listening and podcasts</small></a><a href="/a2/"><b>A2 Complete Course</b><small>All 10 connected units</small></a></div></details>
   <details class="nav-dropdown" data-active={learn.some(item => active(item.href)) ? 'true' : undefined}><summary>Learn <span class="d3-level-pill">{isA2 ? 'A2' : 'A1'}</span><span aria-hidden="true">⌄</span></summary><div class="nav-dropdown__menu">{learn.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}</div></details>
   <a href={isA2 ? '/a2/unit-1/review/' : '/testing/'}>Practice &amp; tests</a><a href="/about/" aria-current={active('/about/') ? 'page' : undefined}>About</a>
   <details class="nav-dropdown nav-dropdown--end d3-language"><summary>Language <span aria-hidden="true">⌄</span></summary><div class="nav-dropdown__menu"><p>Lesson support</p><span>English · پښتو · فارسی · العربية · Українська</span></div></details>
  </nav>
  <details class="mobile-nav d3-mobile-nav"><summary aria-label="Open main navigation" aria-controls="mobile-menu"><span></span><span></span><span></span></summary><nav id="mobile-menu" aria-label="Mobile navigation"><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}><b>Home</b></a><p>Courses</p><a href="/vocabulary/"><b>A1 Foundations</b><small>Start A1</small></a><a href="/a2/"><b>A2 Complete Course</b><small>All 10 units</small></a><p>Learn · {isA2 ? 'A2' : 'A1'}</p>{learn.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}><b>{item.label}</b></a>)}<a href={isA2 ? '/a2/unit-1/review/' : '/testing/'}><b>Practice &amp; tests</b></a><a href="/about/"><b>About</b></a><p>Language support</p><div class="d3-mobile-languages">EN · PS · FA · AR · UK</div></nav></details>
 </div>
</header>
<script>
 const mobile=document.querySelector<HTMLDetailsElement>('.d3-mobile-nav'); const summary=mobile?.querySelector('summary'); const dropdowns=[...document.querySelectorAll<HTMLDetailsElement>('.d3-nav .nav-dropdown')];
 const sync=()=>summary?.setAttribute('aria-label',mobile?.open?'Close main navigation':'Open main navigation'); mobile?.addEventListener('toggle',sync); mobile?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{mobile?.removeAttribute('open');sync();}));
 dropdowns.forEach(dropdown=>dropdown.addEventListener('toggle',()=>{if(dropdown.open)dropdowns.filter(item=>item!==dropdown).forEach(item=>item.removeAttribute('open'));})); document.addEventListener('click',event=>{if(!(event.target instanceof Element)||!event.target.closest('.nav-dropdown'))dropdowns.forEach(item=>item.removeAttribute('open'));}); document.addEventListener('keydown',event=>{if(event.key==='Escape'){mobile?.removeAttribute('open');sync();dropdowns.forEach(item=>item.removeAttribute('open'));summary?.focus();}});
</script>
