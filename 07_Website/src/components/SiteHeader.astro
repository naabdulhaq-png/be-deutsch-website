---
import brandLogo from '../assets/branding/be_deutsch_logo.svg';

const currentPath = Astro.url.pathname;
const navigation = [
  { label: 'App', href: '/app/', path: '/app/' },
  { label: 'A1 Vocabulary', href: '/vocabulary/', path: '/vocabulary/' },
  { label: 'A1 Listening', href: '/listening/', path: '/listening/' },
  { label: 'Podcasts', href: '/podcasts/', path: '/podcasts/' },
  { label: 'Testing', href: '/testing/', path: '/testing/' },
  { label: 'About', href: '/about/', path: '/about/' },
  { label: 'Partners', href: '/partners/', path: '/partners/' },
  { label: 'Support', href: '/support/', path: '/support/' },
] as const;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Be Deutsch homepage">
      <img src={brandLogo.src} width="168" height="42" alt="Be Deutsch" />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={(item.path === currentPath || (['/vocabulary/','/listening/','/podcasts/'].includes(item.path) && currentPath.startsWith(item.path))) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open main navigation" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </summary>
      <nav id="mobile-menu" aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={(item.path === currentPath || (['/vocabulary/','/listening/','/podcasts/'].includes(item.path) && currentPath.startsWith(item.path))) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const mobileMenuSummary = mobileMenu?.querySelector('summary');

  const updateMobileMenuLabel = () => {
    mobileMenuSummary?.setAttribute(
      'aria-label',
      mobileMenu?.open ? 'Close main navigation' : 'Open main navigation',
    );
  };

  mobileMenu?.addEventListener('toggle', updateMobileMenuLabel);

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.removeAttribute('open');
      updateMobileMenuLabel();
    });
  });

  mobileMenu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      mobileMenu.removeAttribute('open');
      updateMobileMenuLabel();
      mobileMenuSummary?.focus();
    }
  });
</script>

<style>
.desktop-nav{gap:clamp(.75rem,1.4vw,1.35rem)}
@media(max-width:64rem){
  .desktop-nav {
    display: none;
  }

  .mobile-nav {
    display: block;
  }

  .mobile-nav summary {
    display: grid;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    place-content: center;
    gap: 0.26rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker { display: none; }

  .mobile-nav summary span {
    display: block;
    inline-size: 1.1rem;
    block-size: 2px;
    background: var(--black);
    border-radius: 2px;
  }

  .mobile-nav nav {
    position: absolute;
    inset-block-start: calc(100% - 0.3rem);
    inset-inline: 0;
    display: grid;
    padding: 0.65rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }

  .mobile-nav nav a {
    padding: 0.8rem 0.9rem;
    color: var(--black);
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-nav nav a[aria-current="page"] {
    color: var(--accent-text);
    background: #FFF3ED;
    border-radius: 0.5rem;
  }

}
</style>
