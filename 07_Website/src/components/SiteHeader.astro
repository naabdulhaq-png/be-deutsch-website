---
import brandMark from '../assets/branding/be_deutsch_icon.svg';

const currentPath = Astro.url.pathname;
const navigation = [
  { label: 'App', href: '/app/', path: '/app/' },
  { label: 'About', href: '/about/', path: '/about/' },
  { label: 'Partners', href: '/partners/', path: '/partners/' },
  { label: 'Support', href: '/support/', path: '/support/' },
] as const;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Be Deutsch homepage">
      <img src={brandMark.src} width="42" height="42" alt="" />
      <span>Be Deutsch</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={item.path === currentPath ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open main navigation" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </summary>
      <nav id="mobile-menu" aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={item.path === currentPath ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const mobileMenuSummary = mobileMenu?.querySelector('summary');

  const updateMobileMenuLabel = () => {
    mobileMenuSummary?.setAttribute(
      'aria-label',
      mobileMenu?.open ? 'Close main navigation' : 'Open main navigation',
    );
  };

  mobileMenu?.addEventListener('toggle', updateMobileMenuLabel);

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.removeAttribute('open');
      updateMobileMenuLabel();
    });
  });

  mobileMenu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      mobileMenu.removeAttribute('open');
      updateMobileMenuLabel();
      mobileMenuSummary?.focus();
    }
  });
</script>
