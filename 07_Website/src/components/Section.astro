---
interface Props {
  id?: string;
  tone?: 'canvas' | 'white' | 'dark' | 'accent';
  size?: 'standard' | 'compact';
  labelledby?: string;
  class?: string;
}

const {
  id,
  tone = 'canvas',
  size = 'standard',
  labelledby,
  class: className,
} = Astro.props;
---

<section
  id={id}
  class:list={['section', `section--${tone}`, `section--${size}`, className]}
  aria-labelledby={labelledby}
>
  <div class="container">
    <slot />
  </div>
</section>
