---

import data from '../data/listening-course.json';
import episodes from '../data/podcasts.json';
import lock from '../../integrity/listening-asset-lock.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import '../styles/listening.css';
interface Props {view:'course'|'lesson'|'podcasts'|'podcast';lessonId?:string;podcastId?:string;}
const {view,lessonId,podcastId}=Astro.props;
const isReview=false,isPodcast=view==='podcast',podcastOverview=view==='podcasts';
const lesson=data.lessons.find(l=>l.id===lessonId);
const selected=isReview?data.recordings:isPodcast?data.recordings.filter(r=>r.id===podcastId):lesson?data.recordings.filter(r=>lesson.recordings.includes(r.id)):[];
const title=isReview?'A1 · Hörstudio':isPodcast?selected[0]?.title||'Deutsch Podcasts':podcastOverview?'Deutsch Podcasts':lesson?lesson.title:'Deutsch hören. Alltag verstehen.';
const fmt=(n:number|null)=>n==null?'Wird gemessen':`${Math.floor(Math.round(n)/60)}:${String(Math.round(n)%60).padStart(2,'0')}`;
const total=(ids:string[])=>ids.reduce((n,id)=>n+(data.recordings.find(r=>r.id===id)?.duration||0),0);

const audioSrc=(id:string)=>lock.recordings[id as keyof typeof lock.recordings].path;
const description=lesson?`Practice A1 German listening: ${lesson.title}. Three approved passages with questions, transcripts and five-language word support.`:isPodcast?'Listen to Ein Morgen in Deutschland, an A1 German podcast with chapters, transcript, questions and saved playback position.':podcastOverview?'Explore beginner German podcasts with clear voices, German transcripts, word glossaries and saved listening position.':'Practise everyday German with 20 A1 listening lessons, 60 audio passages, comprehension questions and optional transcripts.';
---
<BaseLayout title={`${title} — Be Deutsch`} description={description}>
<div id="top"></div><SiteHeader/>
<div class="listening-experience"><div class="listen-main learning-toolbar" lang="de"><button class="sound-toggle subtle" type="button" aria-pressed="true">Quiztöne: an</button></div>
<main id="main-content" class="listen-main" lang="de">
{selected.length===0?<>
<section class="hero"><div><p class="eyebrow">BE DEUTSCH / {podcastOverview?'DEUTSCH PODCASTS':'HÖRTRAINING'}</p><h1>{title}</h1><p class="lead">{podcastOverview?'Mehr Zeit für Deutsch. Begleite zwei Stimmen durch einen ganz normalen Morgen.':'Kleine Geschichten. Echte Situationen. Hör zu und entdecke, wie viel du schon verstehst.'}</p><div class="hero-actions"><a class="continue-learning orange-button" href="/listening/" hidden>Weiterlernen ↗</a><a class="orange-button" href={podcastOverview?'/podcasts/ein-morgen/':'/listening/ht01/'}>{podcastOverview?'Episode hören':'Mit Lektion 1 starten'} <span aria-hidden="true">↗</span></a><span class="quiet">A1 · In deinem Tempo</span></div><div class="feature-line"><span>✓ Klare deutsche Stimmen</span><span>✓ Transkript bei Bedarf</span><span>✓ Fortschritt auf diesem Gerät</span></div></div><div class="hero-art"><img src={data.assets[podcastOverview?'morning':'classroom'].src} alt={data.assets[podcastOverview?'morning':'classroom'].alt}/><div class="audio-badge"><span class="bars" aria-hidden="true">▂ ▅ ▃ ▆ ▂</span><span>{podcastOverview?'Zwei Stimmen. Ein Morgen.':'Hören → Verstehen → Weiterlernen'}</span></div></div></section>
{podcastOverview?<section><div class="section-heading"><div><p class="eyebrow">DEIN ERSTER PODCAST</p><h2>Ein Morgen in Deutschland</h2></div><span class="tag">A1 · {fmt(data.recordings.find(r=>r.id.startsWith('P'))?.duration||null)}</span></div>{episodes.map(e=>{const episode=data.recordings.find(r=>r.id===e.id)!;return <a class="podcast-feature" href={`/podcasts/${e.slug}/`}><span class="round-play" aria-hidden="true">▶</span><div><h3>{episode.title}</h3><p>{e.level} · {fmt(episode.duration)} · Kapitel, Transkript und Fragen</p></div><strong>Episode öffnen ↗</strong></a>;})}<p class="quiet">Dein Hörstand wird auf diesem Gerät gespeichert. Wähle eine Folge und höre in deinem Tempo.</p></section>:<section><div class="section-heading"><div><p class="eyebrow">DEIN LERNWEG</p><h2>Dein Weg durch den Alltag.</h2></div><span class="tag">20 Lektionen · 60 Hörtexte</span></div><div class="lesson-grid">{data.lessons.map((l,i)=><a class="lesson-card" href={`/listening/${l.id.toLowerCase()}/`}><div class="card-art"><img src={data.assets[l.scene as keyof typeof data.assets].src} alt={data.assets[l.scene as keyof typeof data.assets].alt} loading="lazy"/><span class="card-number">{String(i+1).padStart(2,'0')}</span></div><div class="card-body"><p class="eyebrow">{l.stage.replace('/4','/20')}</p><h3>{l.title}</h3><p>{l.objective}</p><div class="card-meta"><span>3 Hörtexte · {fmt(total(l.recordings))}</span><span aria-hidden="true">↗</span></div><span class="lesson-progress quiet" data-lesson={l.id} data-question-counts={JSON.stringify(l.recordings.map(id=>data.recordings.find(r=>r.id===id)?.questions.length||0))}>Noch nicht begonnen</span></div></a>)}</div></section>}
<section class="how-strip"><div><span>01</span><h3>Erst die Situation.</h3><p>Sieh dir das Bild und die Aufgabe an.</p></div><div><span>02</span><h3>Dann die Stimmen.</h3><p>Hör mehrmals zu. Eine kleine Pause hilft.</p></div><div><span>03</span><h3>Jetzt du.</h3><p>Beantworte die Fragen und prüfe die Details.</p></div></section>
</>:<>
<a class="back-link" href={isPodcast?'/podcasts/':'/listening/'}>← {isPodcast?'Alle Podcasts':'Alle Lektionen'}</a>
<section class="lesson-intro"><p class="eyebrow">{isReview?'REVIEW / 60 HÖRTEXTE + 1 PODCAST':isPodcast?'DEUTSCH PODCASTS / EPISODE 01':lesson?.stage.replace('/4','/20')}</p><h1>{title}</h1><p class="lead">{isReview?'Alle Stimmen, Hörtexte und Aufgaben an einem Ort. Die Transkripte bleiben bis zum Öffnen verborgen.':isPodcast?'Frühstück zu Hause, ein Termin im Büro und der Weg zur Arbeit. Hör in vier Kapiteln mit.':lesson?.objective}</p>{lesson&&<details class="preparation"><summary>Vor dem Hören: Wörter und Vorbereitung</summary><p>{lesson.bridge}</p><p>Wortschatz-Lektionen: {lesson.prerequisites.map(n=><span class="prereq">{String(n).padStart(2,'0')} · {data.vocabulary_lessons.find(l=>l.number===n)?.title_de}</span>)}</p></details>}<p class="quiet">Lernmodus: beliebig oft hören · Fragen mit direkter Rückmeldung · Transkript jederzeit als Hilfe verfügbar.</p></section>
{isReview&&<div class="review-controls"><label>Aufnahmen anzeigen <select class="review-filter" aria-label="Aufnahmen filtern"><option value="all">Alle 61 Aufnahmen</option>{data.lessons.map(l=><option value={l.id}>{l.id} · {l.title}</option>)}<option value="podcast">Korrigierter Podcast</option></select></label><p class="quiet">L01: 12 freigegebene Hörtexte · L02: 48 neue Hörtexte · Podcast: Version 2</p></div>}
<div class="activity-stack">{selected.map((r)=>
<article class="activity" id={r.id} data-recording={r.id} data-lesson={r.id.startsWith('HT')?r.id.slice(0,4):'podcast'}>
<div class="activity-heading"><div><p class="eyebrow">{r.id} / {r.model}</p><h2>{r.title}</h2><p>{r.objective}</p></div><span class="duration tag">{fmt(r.duration)}</span></div>
<div class="listening-scene"><img src={data.assets[r.scene as keyof typeof data.assets].src} alt={data.assets[r.scene as keyof typeof data.assets].alt} loading="lazy"/><div><span class="pill">{r.id.startsWith('P')?'A1 · Länger zuhören':Number(r.id.slice(2,4))>=14?'Späteres A1':Number(r.id.slice(2,4))>=3?'A1 im Aufbau':'Frühes A1'}</span><h3>Hör zuerst zu.</h3><p>{r.id.startsWith('P')?'Ein Kapitel reicht für heute? Dein Hörstand wird gespeichert.':'Lies die Fragen. Hör dann den ganzen Text. Du kannst ihn wiederholen.'}</p></div></div>
<div class="player" data-player={r.id}><audio preload="none" src={audioSrc(r.id)} aria-label={r.title}></audio><div class="player-main"><button class="play orange-button" type="button" aria-label={`${r.title} abspielen`}>▶ Abspielen</button><button class="rewind subtle" type="button" aria-label="Zehn Sekunden zurück">−10 s</button><button class="forward subtle" type="button" aria-label="Zehn Sekunden vor">+10 s</button><button class="replay subtle" type="button">↺ Neu hören</button><label class="speed-label">Tempo <select class="speed" aria-label="Wiedergabetempo"><option value="1">1×</option><option value="0.9">0,9×</option><option value="1.1">1,1×</option></select></label></div><label class="seek-label"><span class="sr-only">Audioposition</span><input class="seek" type="range" min="0" max={r.duration||1} value="0" step="0.1"/></label><div class="player-bottom"><span class="time">0:00 / {fmt(r.duration)}</span><span class="play-status" role="status">Bereit zum Hören</span></div>{r.id.startsWith('P')&&<div class="chapters" aria-label="Kapitel">{(r as any).chapters?.map((c:any,i:number)=><button type="button" class="chapter subtle" data-start={c.start}>{String(i+1).padStart(2,'0')} · {c.title} <small>{fmt(c.start)}</small></button>)}</div>}<button class="resume subtle" type="button" hidden>Am gespeicherten Punkt fortsetzen</button></div>
<div class="question-section"><div class="section-heading"><h3>{r.id.startsWith('P')?'Fragen zu den Kapiteln':'Was hast du gehört?'}</h3><span class="score tag" aria-live="polite">0 / {r.questions.length} richtig</span></div><div class="questions">{r.questions.map((q,qi)=><fieldset class="question" data-question={qi} data-answer={q.answer}><legend>{r.id.startsWith('P')&&<span class="chapter-label">Kapitel {(r as any).question_chapters[qi]+1} · </span>}{qi+1}. {q.prompt}</legend><div class:list={['answer-options',{'picture-options':q.kind==='picture'}]}>{q.options.map((o,oi)=><button type="button" class="answer" data-option={oi} aria-pressed="false">{q.kind==='picture'&&<img src={data.assets[['classroom','supermarket','station'][oi] as keyof typeof data.assets].src} alt="" loading="lazy"/>}<span>{o}</span></button>)}</div><p class="feedback" role="status" hidden data-evidence={q.evidence}></p></fieldset>)}</div><button type="button" class="reset-questions subtle">Aufgaben neu beginnen</button><p class="progress-status quiet" aria-live="polite"></p></div>
<details class="transcript"><summary>Deutsches Transkript anzeigen</summary><div>{r.turns.map((t)=><p><strong>{(t as any).label||(t.role==='F'?'Frau':'Mann')}{r.turns.length===1?' / Erzählstimme':''}:</strong> {t.text}</p>)}</div></details>
<details class="glossary"><summary>Wichtige Wörter ansehen</summary><label>Sprache <select class="glossary-language" aria-label="Sprache für einzelne Wörter">{Object.entries(data.languages).map(([code,l])=><option value={code}>{l.native_label}</option>)}</select></label><dl>{r.glossary_words.map(w=><div><dt>{w}</dt><dd>{data.glossary[w as keyof typeof data.glossary]?Object.entries(data.glossary[w as keyof typeof data.glossary]).map(([code,translation])=><span class="word-translation" lang={code} dir={translation.direction} data-lang={code} hidden={code!=='en'}>{translation.text}</span>):<span lang="de">{data.extra_glossary_de[w as keyof typeof data.extra_glossary_de]||'Im Kontext hören.'}</span>}</dd></div>)}</dl></details>
{isReview&&<details class="voice-review"><summary>Stimmen und Audiodaten prüfen</summary><p>Datei: <a href={audioSrc(r.id)}>{r.id}.mp3</a> · Gemessene Dauer: {fmt(r.duration)}</p>{[...new Set(r.turns.map(t=>t.role))].map(role=><p>{role} · {data.voices[role as 'M'|'F'].name} · <code>{data.voices[role as 'M'|'F'].id}</code></p>)}<p>Stimme, Natürlichkeit, Aussprache und Transkript bitte anhören und freigeben. Keine qualifizierte menschliche Freigabe behauptet.</p></details>}
</article>)}</div>
{lesson&&<nav class="lesson-next" aria-label="Weitere Lektionen">{data.lessons.filter(l=>Math.abs(Number(l.id.slice(2))-Number(lesson.id.slice(2)))===1).map(l=><a class="subtle" href={`/listening/${l.id.toLowerCase()}/`}>{Number(l.id.slice(2))<Number(lesson.id.slice(2))?'←':'→'} {l.id} · {l.title}</a>)}<label>Lektion wählen <select class="lesson-select" aria-label="Lektion wählen">{data.lessons.map(l=><option value={`/listening/${l.id.toLowerCase()}/`} selected={l.id===lesson.id}>{l.id} · {l.title}</option>)}</select></label></nav>}
</>}
</main>
</div><SiteFooter/>
<script>import '../scripts/listening';</script>
</BaseLayout>
