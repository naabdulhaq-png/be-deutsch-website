---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const features=[
 {icon:'W',title:'Vocabulary',text:'Build practical words through illustrated lessons and natural pronunciation.',href:'/vocabulary/'},
 {icon:'G',title:'Grammar',text:'Understand useful structures with focused explanations and practice.',href:'/grammar/'},
 {icon:'L',title:'Listening',text:'Train your ear with everyday dialogues and clear audio controls.',href:'/listening/'},
 {icon:'P',title:'Podcasts',text:'Follow longer conversations in manageable chapters.',href:'/podcasts/'},
];
---
<BaseLayout title="Learn German with Be Deutsch" description="Learn German step by step with complete A1 and A2 courses, vocabulary, grammar, listening, podcasts and practice.">
 <div id="top"></div><SiteHeader/>
 <main id="main-content" class="d3-home">
  <section class="d3-hero"><div class="container d3-hero__grid"><div><p class="d3-kicker">German learning that feels clear</p><h1>Learn German<br/>with <span>Be Deutsch.</span></h1><p class="d3-hero__lead">A welcoming, structured path from A1 foundations to a complete A2 course—with vocabulary, grammar, listening, podcasts and meaningful practice.</p><div class="d3-actions"><a class="d3-button d3-button--orange" href="/vocabulary/">Start A1 Foundations →</a><a class="d3-button d3-button--light" href="/a2/">Explore A2 Course</a></div></div><div class="d3-hero__visual"><img src="/redesign-assets/hero-vocabulary.png" width="1200" height="720" alt="A learner studying German in a bright, welcoming room"/><span class="d3-hero__seal">A1 + A2 · Learn at your pace</span></div></div></section>
  <section aria-labelledby="courses-title"><div class="container"><div class="d3-section-head"><p class="d3-kicker">Choose your level</p><h2 id="courses-title">Two clear routes forward.</h2><p>Start with everyday foundations or continue through the complete ten-unit A2 journey. Every section uses the same familiar learning pattern.</p></div><div class="d3-course-grid">
   <article class="d3-course-card"><span class="d3-level">A1</span><div><h3>A1 Foundations</h3><p>Build everyday German through focused vocabulary, grammar, listening and podcast lessons.</p><div class="d3-facts"><span>40 vocabulary lessons</span><span>28 grammar topics</span><span>20 listening lessons</span></div><a class="d3-button" href="/vocabulary/">Start A1 →</a></div></article>
   <article class="d3-course-card d3-course-card--a2"><span class="d3-level">A2</span><div><h3>A2 Complete Course</h3><p>Continue through ten connected units with preserved lessons, practice, revision and progress.</p><div class="d3-facts"><span>10 units</span><span>300 vocabulary records</span><span>40 grammar topics</span></div><a class="d3-button d3-button--orange" href="/a2/">Start A2 →</a></div></article>
  </div></div></section>
  <section class="d3-features" aria-labelledby="features-title"><div class="container"><div class="d3-section-head"><p class="d3-kicker">Learn in four ways</p><h2 id="features-title">Everything works together.</h2><p>Discover each learning area quickly, then stay in the level you selected.</p></div><div class="d3-feature-grid">{features.map(item=><a class="d3-feature" href={item.href}><i>{item.icon}</i><h3>{item.title}</h3><p>{item.text}</p></a>)}</div></div></section>
  <section aria-labelledby="journey-title"><div class="container"><div class="d3-section-head"><p class="d3-kicker">Your learner journey</p><h2 id="journey-title">Small steps. Visible progress.</h2></div><div class="d3-journey-grid"><article class="d3-step"><span>01</span><h3>Choose a level</h3><p>Begin with A1 or enter the complete A2 course.</p></article><article class="d3-step"><span>02</span><h3>Learn and practise</h3><p>Move between words, structures, listening and longer audio.</p></article><article class="d3-step"><span>03</span><h3>Check your progress</h3><p>Use lesson quizzes, revision and assessments when you are ready.</p></article></div></div></section>
  <section class="d3-tests" aria-labelledby="tests-title"><div class="container"><div class="d3-test-panel"><div><p class="d3-kicker">Practice &amp; assessment</p><h2 id="tests-title">Test your German.</h2><p>Check what you know after exploring the course, with existing quizzes and assessments.</p><div class="d3-actions"><a href="/testing/">Become a Beta Tester</a><a href="/app/">Explore the App</a></div></div><a class="d3-button d3-button--orange" href="/testing/">View tests →</a></div></div></section>
 </main><SiteFooter/>
</BaseLayout>
