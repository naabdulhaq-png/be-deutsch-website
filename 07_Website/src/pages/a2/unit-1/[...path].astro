---
import { site } from '../../../config/site';
import data from '../../../a2/data/course.json';
import type { AudioAsset } from '../../../a2/lib/model';
import AudioPlayer from '../../../a2/components/AudioPlayer.astro';
import Assessment from '../../../a2/components/Assessment.astro';
import LearningChrome from '../../../components/redesign/LearningChrome.astro';
import SupportLanguageSelector from '../../../a2/components/SupportLanguageSelector.astro';
import GrammarPage from '../../../a2/components/pages/GrammarPage.astro';
import VocabularyPage from '../../../a2/components/pages/VocabularyPage.astro';
import ListeningPage from '../../../a2/components/pages/ListeningPage.astro';
import PodcastPage from '../../../a2/components/pages/PodcastPage.astro';
import RevisionPage from '../../../a2/components/pages/RevisionPage.astro';
import '../../../a2/styles/a2.css';
import '../../../styles/bd-ui-07.css';

export function getStaticPaths() {
  return [
    { params: { path: undefined }, props: { kind: 'home', id: '' } },
    ...data.grammar.map((lesson) => ({ params: { path: `grammar/${lesson.id.slice(-3).toLowerCase()}` }, props: { kind: 'grammar', id: lesson.id } })),
    ...data.vocabulary.map((lesson) => ({ params: { path: `vocabulary/${lesson.id.slice(-3).toLowerCase()}` }, props: { kind: 'vocabulary', id: lesson.id } })),
    ...['A2-U01-L01', 'A2-U01-L02'].map((id) => ({ params: { path: `listening/${id.slice(-3).toLowerCase()}` }, props: { kind: 'listening', id } })),
    { params: { path: 'podcast' }, props: { kind: 'podcast', id: 'A2-P01' } },
    { params: { path: 'grammar-review' }, props: { kind: 'grammar-review', id: 'A2-U01-R01' } },
    { params: { path: 'review' }, props: { kind: 'review', id: 'A2-U01' } },
    { params: { path: 'revision' }, props: { kind: 'revision', id: 'A2-U01' } },
  ];
}

const { kind, id } = Astro.props;
const grammar = data.grammar.find((lesson) => lesson.id === id);
const vocabulary = data.vocabulary.find((lesson) => lesson.id === id);
const title = grammar?.title ?? vocabulary?.title ?? ({
  home: 'Life Updates and Recent Experiences',
  listening: id.endsWith('L01') ? 'Weekend Update' : 'A Short Experience Story',
  podcast: data.podcast.title,
  'grammar-review': 'Grammar unit review',
  review: 'Integrated Unit 1 review',
  revision: 'Revision and practice bank',
}[kind] ?? 'Unit 1');
const chromeArea = (['grammar', 'vocabulary', 'listening', 'podcast'].includes(kind) ? kind : 'overview') as 'grammar' | 'vocabulary' | 'listening' | 'podcast' | 'overview';
const objective = grammar?.objectives[0] ?? vocabulary?.objective ?? (kind === 'listening'
  ? 'Listen to both approved passages, identify the main event and sequence, and check important details.'
  : kind === 'podcast'
    ? data.podcast.objective
    : kind === 'revision'
      ? 'Review the right material at the right time and practise with the approved source bank.'
      : 'Tell someone about a recent experience and connect the moments into a clear short account.');
const areaLabels: Record<string, string> = { home: 'Course overview', grammar: 'Grammar', vocabulary: 'Vocabulary', listening: 'Listening', podcast: 'Podcast', revision: 'Revision', review: 'Assessment', 'grammar-review': 'Grammar review' };
const route = (section: string, lesson: string) => `/a2/unit-1/${section}/${lesson.slice(-3).toLowerCase()}/`;
const sequence = [
  ...data.grammar.map((lesson) => ({ id: lesson.id, href: route('grammar', lesson.id), label: lesson.title })),
  ...data.vocabulary.map((lesson) => ({ id: lesson.id, href: route('vocabulary', lesson.id), label: lesson.title })),
  { id: 'A2-U01-L01', href: route('listening', 'A2-U01-L01'), label: 'Weekend Update' },
  { id: 'A2-U01-L02', href: route('listening', 'A2-U01-L02'), label: 'A Short Experience Story' },
  { id: 'A2-P01', href: '/a2/unit-1/podcast/', label: data.podcast.title },
];
const sequenceIndex = sequence.findIndex((item) => item.id === id);
const previous = sequenceIndex > 0 ? sequence[sequenceIndex - 1] : undefined;
const next = sequenceIndex >= 0 && sequenceIndex < sequence.length - 1 ? sequence[sequenceIndex + 1] : undefined;
const assets = data.audio as AudioAsset[];
const audio = (key: string) => assets.find((asset) => asset.id === key)!;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"/>
    <meta name="referrer" content="strict-origin-when-cross-origin"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="robots" content="index,follow,max-image-preview:large"/>
    <title>{title} · A2 Unit 1 · Be Deutsch</title>
    <meta name="description" content={`A2 Unit 1 German learning: ${title}. Five-language learner support and approved German audio.`}/>
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href}/>
  </head>
  <body data-page-id={id || 'A2-U01-home'} data-a2-kind={kind}>
    <a class="skip-link" href="#main">Skip to learning content</a>
    <LearningChrome area={chromeArea} level="A2" title={title}/>
    <main id="main">
      <div class="breadcrumb"><a href="/a2/unit-1/">A2 Unit 1</a><span aria-hidden="true">/</span>{kind === 'home' ? 'Overview' : title}</div>
      <header class:list={['hero', `hero--${chromeArea}`, 'bd07-lesson-hero']}>
        <div class="hero-copy">
          <p class="eyebrow">A2 Unit 1 · {areaLabels[kind] ?? 'Learning'}</p>
          <h1>{title}</h1>
          <p>{objective}</p>
          <div class="hero-pills"><span class="is-level">A2</span><span class="is-area">{areaLabels[kind] ?? 'Learning'}</span>{kind === 'vocabulary' && <span class="is-count">15 words</span>}{kind === 'podcast' && <span class="is-count">5 chapters · 5:49</span>}</div>
        </div>
        {sequenceIndex >= 0 && <aside class="hero-progress"><strong>Lesson progress</strong><progress max="2" value="0" data-hero-progress aria-label="Lesson progress"/><span data-hero-progress-label>Review content and complete the check</span></aside>}
      </header>

      <SupportLanguageSelector/>
      <p id="storage-status" role="status" class="muted storage-status" tabindex="-1">Progress stays in this browser, separately from A1.</p>

      {kind === 'home' && <>
        <section class="unit-progress"><h2>Your Unit 1 journey</h2><progress id="unit-progress" max="16" value="0" aria-label="Unit completion requirements"/><p id="unit-progress-label">0 of 16 learning and review requirements complete</p><a class="button" id="resume-learning" href={route('grammar', 'A2-U01-G01')}>Start learning</a></section>
        <div class="course-grid">
          <section class="course-card is-violet"><p class="eyebrow">Grammar</p><h2>Four connected topics</h2><ol>{data.grammar.map((lesson) => <li><a href={route('grammar', lesson.id)}>{lesson.title}</a><span class="completion" data-completion={lesson.id}></span></li>)}</ol><a href="/a2/unit-1/grammar-review/">Grammar unit review</a></section>
          <section class="course-card is-blue"><p class="eyebrow">Vocabulary</p><h2>Four lessons · 60 records</h2><ol>{data.vocabulary.map((lesson) => <li><a href={route('vocabulary', lesson.id)}>{lesson.title}</a><span class="completion" data-completion={lesson.id}></span></li>)}</ol></section>
          <section class="course-card is-mint"><p class="eyebrow">Listening</p><h2>Four passages</h2><a href={route('listening', 'A2-U01-L01')}>Weekend Update · 2 passages</a><a href={route('listening', 'A2-U01-L02')}>A Short Experience Story · 2 passages</a></section>
          <section class="course-card is-orange"><p class="eyebrow">Podcast</p><h2 lang="de">{data.podcast.title}</h2><p>One approved episode with five individually navigable chapters.</p><a href="/a2/unit-1/podcast/">Open featured episode</a></section>
        </div>
        <section class="callout"><h2>Bring the unit together</h2><p>Use the real Grammar, Vocabulary, Listening and Podcast checks in one 48-question review.</p><a class="button" href="/a2/unit-1/review/">Open the integrated review</a></section>
      </>}

      {kind === 'grammar' && <GrammarPage id={id}/>}
      {kind === 'vocabulary' && <VocabularyPage id={id}/>}
      {kind === 'listening' && <ListeningPage id={id}/>}
      {kind === 'podcast' && <PodcastPage/>}
      {kind === 'revision' && <RevisionPage/>}

      {kind === 'grammar-review' && <section class="review-overview bd07-color-panel"><div><p class="section-kicker">Grammar review</p><h2>Connect all four topics</h2><ul>{data.grammarReview.objectives.map((item) => <li>{item}</li>)}</ul></div><div><h3>Mastery and recovery</h3><p>{data.grammarReview.mastery}</p><ul>{data.grammarReview.remediation.map((item) => <li>{item}</li>)}</ul></div></section>}
      {kind === 'grammar-review' && <Assessment contexts={['A2-U01-R01']} title="Grammar unit review · 16 questions"/>}

      {kind === 'review' && <>
        <section class="review-overview bd07-color-panel"><div><p class="section-kicker">Integrated review</p><h2>48 approved questions</h2><p>Grammar, Vocabulary, Listening and Podcast remain separate sections with feedback after each submission.</p></div><div><AudioPlayer asset={audio('A2-U01-R01-L01-AUDIO')} label="Review listening: Eine kleine Feier am Sonntag"/><AudioPlayer asset={audio('A2-P01-AUDIO')} label="Podcast review"/></div></section>
        <details class="gated-transcript" data-gate="integrated:listening"><summary>Fresh review transcript · after Listening submission</summary><div>{data.freshListening.turns.map((turn) => <p lang="de"><strong>{turn.speaker}: </strong>{turn.text}</p>)}</div></details>
        <details class="gated-transcript" data-gate="integrated:podcast"><summary>Podcast Chapter 3 transcript · after Podcast submission</summary><div>{data.podcast.chapters[2].turns.map((turn) => <p lang="de"><strong>{turn.speaker}: </strong>{turn.text}</p>)}</div></details>
        <Assessment contexts={['integrated:grammar', 'integrated:vocabulary', 'integrated:listening', 'integrated:podcast']} integrated title="Integrated review · 48 questions"/>
      </>}

      {['grammar', 'vocabulary', 'listening', 'podcast'].includes(kind) && <section class="finish-learning"><h2>Finish this learning page</h2><label class="checkline"><input type="checkbox" data-reviewed={id}/> I have reviewed this lesson’s learning content</label><p class="muted">Submit its selected check as well to complete the learning entry. A low score recommends revision without blocking the next lesson.</p></section>}

      {sequenceIndex >= 0 && <nav class="lesson-nav-gradient" aria-label="Previous and next learning pages">
        {previous ? <a class="previous" href={previous.href}><span aria-hidden="true">←</span><span><small>Previous lesson</small>{previous.label}</span></a> : <span class="previous disabled" aria-disabled="true">Start of Unit 1</span>}
        {next ? <a class="next" href={next.href}><span><small>Next lesson</small>{next.label}</span><span aria-hidden="true">→</span></a> : <a class="next" href="/a2/unit-1/review/"><span><small>Next step</small>Integrated review</span><span aria-hidden="true">→</span></a>}
      </nav>}
      {sequenceIndex < 0 && kind !== 'home' && <nav class="lesson-nav-gradient" aria-label="Continue learning"><a class="previous" href="/a2/unit-1/"><span aria-hidden="true">←</span><span><small>Course</small>Unit overview</span></a><a class="next" href="/a2/unit-1/revision/"><span><small>Continue</small>Revision and practice</span><span aria-hidden="true">→</span></a></nav>}
    </main>
    <footer><p>Be Deutsch · Learn a little. Say a little more.</p><p>No account or cloud progress · A1 and A2 progress stay separate.</p><p><a href="/privacy/" style="color:inherit">Privacy</a> · <a href="/impressum/" style="color:inherit">Legal notice</a> · <a href="/support/" style="color:inherit">Support</a></p></footer>
    <script>import '../../../a2/scripts/app'; import '../../../a2/scripts/experience'; import '../../../a2/scripts/support-language';</script>
  </body>
</html>
