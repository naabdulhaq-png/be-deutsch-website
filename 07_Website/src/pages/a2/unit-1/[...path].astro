---
import { site } from '../../../config/site';
import data from '../../../a2/data/course.json';
import type { AudioAsset } from '../../../a2/lib/model';
import AudioPlayer from '../../../a2/components/AudioPlayer.astro';
import Practice from '../../../a2/components/Practice.astro';
import Assessment from '../../../a2/components/Assessment.astro';
import logo from '../../../assets/branding/be_deutsch_logo.svg';
import '../../../a2/styles/a2.css';
export function getStaticPaths(){return [{params:{path:undefined},props:{kind:'home',id:''}},...data.grammar.map(l=>({params:{path:`grammar/${l.id.slice(-3).toLowerCase()}`},props:{kind:'grammar',id:l.id}})),...data.vocabulary.map(l=>({params:{path:`vocabulary/${l.id.slice(-3).toLowerCase()}`},props:{kind:'vocabulary',id:l.id}})),...['A2-U01-L01','A2-U01-L02'].map(id=>({params:{path:`listening/${id.slice(-3).toLowerCase()}`},props:{kind:'listening',id}})),{params:{path:'podcast'},props:{kind:'podcast',id:'A2-P01'}},{params:{path:'grammar-review'},props:{kind:'grammar-review',id:'A2-U01-R01'}},{params:{path:'review'},props:{kind:'review',id:'A2-U01'}},{params:{path:'revision'},props:{kind:'revision',id:'A2-U01'}}];}
const {kind,id}=Astro.props;
const grammar=data.grammar.find(l=>l.id===id), vocabulary=data.vocabulary.find(l=>l.id===id);
const title=grammar?.title??vocabulary?.title??({home:'Life Updates and Recent Experiences',listening:id.endsWith('L01')?'Weekend Update':'A Short Experience Story',podcast:data.podcast.title,'grammar-review':'Grammar unit review',review:'Integrated Unit 1 review',revision:'Revision and practice bank'}[kind]??'Unit 1');
const assets=data.audio as AudioAsset[];
const audio=(key:string)=>assets.find(a=>a.id===key)!;
const contentAudio=(key:string)=>assets.filter(a=>a.contentId===key);
const route=(section:string,lesson:string)=>`/a2/unit-1/${section}/${lesson.slice(-3).toLowerCase()}/`;
const contexts=kind==='review'?['integrated:grammar','integrated:vocabulary','integrated:listening','integrated:podcast']:[id];
const passages=kind==='listening'?data.passages.filter(p=>p.lesson_id===id):[];
---
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"/><meta name="referrer" content="strict-origin-when-cross-origin"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="index,follow,max-image-preview:large"/><title>{title} · A2 Unit 1 · Be Deutsch</title><meta name="description" content={`A2 Unit 1 German learning: ${title}. English support and approved German audio.`}/><link rel="canonical" href={new URL(Astro.url.pathname,site.url).href}/></head>
<body data-page-id={id||'A2-U01-home'}><a class="skip-link" href="#main">Skip to learning content</a>
<header class="site-header"><a href="/a2/unit-1/" aria-label="Be Deutsch A2 Unit 1 home"><img src={logo.src} alt="Be Deutsch" width="180" height="48"/></a><span class="preview-badge">A2 · Unit 1 · English support</span></header>
<div class="preview-notice"><strong>A2 Unit 1 is available.</strong> Learn with English support and reviewed German audio. Your progress stays on this device.</div>
<nav class="level-nav" aria-label="Course levels"><a href="/">Website home</a><a href="/grammar/">A1 Grammar</a><a href="/vocabulary/">A1 Vocabulary</a><a href="/listening/">A1 Listening</a><a href="/podcasts/">A1 Podcasts</a><a href="/a2/unit-1/" aria-current="location">A2 Unit 1</a></nav><nav class="section-nav" aria-label="A2 learning sections"><a href="/a2/unit-1/">Unit overview</a><a href={route('grammar','A2-U01-G01')}>Grammar</a><a href={route('vocabulary','A2-U01-V01')}>Vocabulary</a><a href={route('listening','A2-U01-L01')}>Listening</a><a href="/a2/unit-1/podcast/">Podcast</a><a href="/a2/unit-1/review/">Unit review</a><a href="/a2/unit-1/revision/">Revision</a></nav>
<main id="main"><div class="breadcrumb"><a href="/a2/unit-1/">A2 Unit 1</a> <span aria-hidden="true">/</span> {kind==='home'?'Overview':title}</div>
<div class="hero"><p class="eyebrow">BE DEUTSCH · A2-U01 {id&&`· ${id}`}</p><h1>{title}</h1><p>{kind==='home'?'Tell someone about your weekend. Share a milestone, react to news, and connect the moments into a short story.':'Learn at your own pace. Use the explanations, listen carefully, and practise before the scored check.'}</p></div>
<p id="storage-status" role="status" class="muted">Progress stays in this browser, separately from A1.</p>
{kind==='home'&&<>
 <section class="unit-progress"><h2>Your Unit 1 journey</h2><progress id="unit-progress" max="16" value="0" aria-label="Unit completion requirements"/><p id="unit-progress-label">0 of 16 learning and review requirements complete</p><a class="button" id="resume-learning" href={route('grammar','A2-U01-G01')}>Start learning</a><p class="muted">Eleven learning entries count after you review the content and submit their selected quiz. The Grammar review and four integrated review sections complete the unit. A low score recommends revision; it never locks learning.</p></section>
 <div class="course-grid">{[['Grammar','Build short past accounts',data.grammar,'grammar'],['Vocabulary','60 records for your everyday stories',data.vocabulary,'vocabulary']].map(([name,desc,lessons,section])=><section class="course-card"><p class="eyebrow">{name as string}</p><h2>{desc as string}</h2><ol>{(lessons as typeof data.grammar).map(l=><li><a href={route(section as string,l.id)}>{l.title}</a> <span class="completion" data-completion={l.id}></span></li>)}</ol>{section==='grammar'&&<a href="/a2/unit-1/grammar-review/">Grammar unit review · 16 questions</a>}</section>)}
 <section class="course-card"><p class="eyebrow">Listening</p><h2>Listen for the story</h2><p>Two lessons, four personal updates and experience stories.</p><ul><li><a href={route('listening','A2-U01-L01')}>Weekend Update</a> <span data-completion="A2-U01-L01"></span></li><li><a href={route('listening','A2-U01-L02')}>A Short Experience Story</a> <span data-completion="A2-U01-L02"></span></li></ul></section>
 <section class="course-card"><p class="eyebrow">Podcast</p><h2 lang="de">Mein Wochenende in vier Stationen</h2><p>Follow Mina and Jonas through five chapters of a changing Saturday.</p><a href="/a2/unit-1/podcast/">Listen to the episode · 5:49</a> <span data-completion="A2-P01"></span></section></div>
 <section><h2>What you will be able to do</h2><ul><li>Describe familiar completed events in a short sequence.</li><li>Identify the main event and details in a personal update.</li><li>Write a short experience message using simple connectors.</li></ul><p>Start with A1 present forms, subject–verb agreement, main-clause word order and familiar time expressions. Each section remains independently accessible.</p></section>
 <section class="callout"><h2>Bring the unit together</h2><p>16 Grammar + 20 Vocabulary + 6 fresh Listening + 6 Podcast Chapter 3 questions.</p><a class="button" href="/a2/unit-1/review/">Open the integrated review</a></section>
 <details><summary>Grammar terminology</summary><dl>{data.terminology.map(t=><><dt>{t.term}</dt><dd>{t.plain} · <span lang="de">{t.example}</span></dd></>)}</dl></details>
</>}
{grammar&&<>
 <section><h2>Learning objectives</h2><ul>{grammar.objectives.map(s=><li>{s}</li>)}</ul><h3>Before you start</h3><p>{grammar.prerequisites.join(' · ')}</p><h3>A familiar situation</h3><p>{grammar.situation}</p></section>
 <section><h2>Step by step</h2>{grammar.steps.map(([heading,body])=><article class="explanation"><h3>{heading}</h3><p>{body}</p></article>)}<h3>Sentence structure</h3><ul>{grammar.structure.map(s=><li>{s}</li>)}</ul></section>
 <section><h2>Hear the examples</h2>{grammar.examples.map(([de,en],i)=><article class="example"><p lang="de" class="german">{de}</p><p>{en}</p><AudioPlayer asset={audio(`${id}-A-EX${String(i+1).padStart(2,'0')}`)} label={`Example ${i+1}`}/></article>)}<h3>Model dialogue</h3><AudioPlayer asset={audio(`${id}-A-DLG01`)} label="Model dialogue"/><details><summary>Dialogue transcript</summary>{audio(`${id}-A-DLG01`).voices.map(v=><p lang="de"><strong>{v.speaker}: </strong>{v.text}</p>)}</details></section>
 <section><h2>Everyday use</h2><ul>{grammar.communication.map(s=><li>{s}</li>)}</ul><h3>Common mistakes</h3>{grammar.mistakes.map(([bad,good,why])=><article class="example"><p>{bad}</p><p class="german" lang="de">{good}</p><p>{why}</p></article>)}</section>
 <Practice title="Guided practice" rows={grammar.guided}/><Practice title="Independent practice" rows={grammar.independent}/>
 <section><h2>Summary and revision</h2><p>{grammar.summary}</p><p>{grammar.review}</p><p>Connections: {grammar.links.join(' · ')}</p></section>
</>}
{vocabulary&&<>
 <section><h2>Learning objectives</h2><p>{vocabulary.objective}</p><ul>{vocabulary.subobjectives.map(s=><li>{s}</li>)}</ul><p>Prerequisites: {vocabulary.prerequisites.join(' · ')}</p><p>{vocabulary.intro}</p><h3>Useful phrases</h3><ul>{vocabulary.phrases.map(s=><li lang="de">{s}</li>)}</ul><p class="notice">Productive: retrieve and use the item. Receptive: recognize it in context; production is optional. A1 review items are not counted as new A2 headwords.</p></section>
 <section><h2>Your 15 vocabulary records</h2><div class="lexical-grid">{data.lexical.filter(x=>x.lesson_id===id).map(x=><article class="lexical" id={x.lexical_id}><p class="eyebrow">{x.status} · {x.lexical_id}</p><h3 lang="de">{x.headword}</h3><p class="meaning">{x.meaning_en}</p><dl>{[['Part of speech',x.part_of_speech],['Article',x.article],['Singular',x.singular],['Plural',x.plural],['Verb forms',x.verb_principal_forms],['Auxiliary',x.perfekt_auxiliary],['Construction',x.separable_reflexive],['Case or preposition',x.case_preposition]].filter(([,v])=>v).map(([key,value])=><><dt>{key}</dt><dd lang={["Article","Singular","Plural","Verb forms","Auxiliary"].includes(key)?"de":undefined}>{value}</dd></>)}</dl><p lang="de" class="german">{x.example_de}</p><p>{x.example_en}</p><p><strong>Useful combinations: </strong><span lang="de">{x.collocations}</span></p><p>{x.usage_note}</p><p class="muted">{x.a1_overlap_status}</p>{contentAudio(x.lexical_id).map(a=><AudioPlayer asset={a} label={a.id.endsWith('-WORD')?'Pronunciation':a.id.endsWith('-FORM')?'Forms':'Example sentence'}/>)}<button class="quiet recall" data-recall={x.lexical_id} data-receptive={String(x.status==='Receptive')}>{x.status==='Receptive'?'I recognize this in context':'I recalled this word'}</button><span class="recall-status muted" data-recall-status={x.lexical_id}></span></article>)}</div></section>
 <section><h2>Common mistakes</h2>{vocabulary.mistakes.map(([bad,good,why])=><article class="example"><p>{bad}</p><p>{good}</p><p>{why}</p></article>)}</section><Practice title="Guided practice" rows={vocabulary.guided}/><Practice title="Independent practice" rows={vocabulary.independent}/><section><h2>Summary and revision</h2><p>{vocabulary.summary}</p><p>{vocabulary.revision}</p></section>
</>}
{kind==='listening'&&<>
 <section><h2>Listen in two passes</h2><p>First listen for the main event. Listen again for details, then answer the lesson check. Transcripts stay hidden until submission unless you deliberately choose study support.</p><label class="checkline"><input type="checkbox" class="study-support"/> Use transcript study support (recorded as an aided attempt)</label></section>
 {passages.map(p=><section class="passage"><p class="eyebrow">{p.id}</p><h2>{p.title}</h2><p>{p.objective}</p><p>{p.description_en}</p><p class="muted">{p.speakers} · {p.setting} · {p.difficulty}</p><AudioPlayer asset={audio(`${p.id}-AUDIO`)} label={p.title}/><details class="gated-transcript" data-gate={id}><summary>German transcript — available after the check or with study support</summary><div>{p.turns.map(t=><p lang="de"><strong>{t.speaker}: </strong>{t.text}</p>)}</div></details><p class="muted">Reinforcement: {p.grammar_refs?.join(' · ')} {p.vocabulary_refs?.join(' · ')}</p></section>)}
</>}
{kind==='podcast'&&<>
 <section><h2>Listen to Mina and Jonas</h2><p>{data.podcast.summary_en}</p><p>{data.podcast.objective}</p><AudioPlayer asset={audio('A2-P01-AUDIO')} label={data.podcast.title}/><nav class="chapter-nav" aria-label="Podcast chapters">{data.podcast.chapters.map(ch=><button type="button" data-chapter-start={ch.start} data-chapter-end={ch.end}>Chapter {ch.number}: {ch.title} <span>{Math.floor(ch.start/60)}:{Math.floor(ch.start%60).toString().padStart(2,'0')}</span></button>)}</nav><p id="chapter-status" role="status" class="muted">Choose a chapter, or listen to the whole episode.</p><label class="checkline"><input type="checkbox" class="study-support"/> Use transcript study support (aided attempt)</label></section>
 <section><h2>Language connections</h2><p>Vocabulary references: {data.podcast.vocabulary_refs.join(' · ')}</p><p>Grammar references: {data.podcast.grammar_refs.join(' · ')}</p><p><a href="/a2/unit-1/vocabulary/v01/">Review the unit vocabulary</a> · <a href="/a2/unit-1/grammar/g01/">Review the Perfekt sentence pattern</a></p></section>
 {data.podcast.chapters.map(ch=><section><h2>Chapter {ch.number}: <span lang="de">{ch.title}</span></h2><details class="gated-transcript" data-gate="A2-P01"><summary>Chapter transcript — available after the check or with study support</summary><div>{ch.turns.map(t=><p lang="de"><strong>{t.speaker}: </strong>{t.text}</p>)}</div></details></section>)}
</>}
{kind==='grammar-review'&&<section><h2>Review aims</h2><ul>{data.grammarReview.objectives.map(s=><li>{s}</li>)}</ul><p>{data.grammarReview.mastery}</p><ul>{data.grammarReview.remediation.map(s=><li>{s}</li>)}</ul></section>}
{kind==='review'&&<section><h2>Audio for the review</h2><p>For the Listening section, hear Ben's Sunday celebration. For the Podcast section, replay Chapter 3. The approved duration exceptions do not change the questions.</p><AudioPlayer asset={audio('A2-U01-R01-L01-AUDIO')} label="Fresh review: Eine kleine Feier am Sonntag"/><AudioPlayer asset={audio('A2-P01-AUDIO')} label="Podcast review: Chapter 3"/><button type="button" data-review-chapter>Play Chapter 3 (2:20–3:32)</button><details class="gated-transcript" data-gate="integrated:listening"><summary>Fresh review transcript — after Listening submission</summary><div>{data.freshListening.turns.map(t=><p lang="de"><strong>{t.speaker}: </strong>{t.text}</p>)}</div></details><details class="gated-transcript" data-gate="integrated:podcast"><summary>Podcast Chapter 3 transcript — after Podcast submission</summary><div>{data.podcast.chapters[2].turns.map(t=><p lang="de"><strong>{t.speaker}: </strong>{t.text}</p>)}</div></details></section>}
{!['home','revision'].includes(kind)&&<Assessment contexts={contexts} integrated={kind==='review'} title={kind==='review'?'Integrated review · 48 questions':'Selected knowledge check'}/>}
{kind==='podcast'&&<><Assessment contexts={['optional:A2-P01']} title="Optional podcast practice · not part of your scored episode check"/><Practice title="Podcast learning activities" rows={data.podcastActivities.map(a=>[a.activity_id,a.instructions_en,a.model_or_key,a.self_check])}/></>}
{kind==='revision'&&<>
 <section><h2>Spaced revision plan</h2><p>Recall productive words; recognize receptive words in context. Check meaning, articles/forms, collocations and event order. A miss schedules a next-day retry, not a course lock.</p>{data.revisionPlan.map(row=><article class="example"><h3>{row[0]} · {row[1]}</h3>{row.slice(2).map(s=><p>{s}</p>)}</article>)}<h3>Due review</h3><ul id="due-review"></ul><p id="due-empty">No scheduled items yet. Use vocabulary recall or complete a knowledge check.</p></section>
 <section><h2>Extra practice bank</h2><p>All 202 source questions are available here. These practice sessions do not replace the selected scored checks or change unit completion.</p><label for="bank-filter">Choose a source bank</label><select id="bank-filter">{data.grammar.map(l=><option value={l.id}>{l.id} · {l.title}</option>)}{data.vocabulary.map(l=><option value={l.id}>{l.id} · {l.title}</option>)}<option value="A2-U01-R01">Grammar review pool</option><option value="audio">All audio questions</option><option value="all">All 202 questions</option></select><button type="button" id="load-bank">Open practice session</button><div id="bank-assessment"></div></section>
</>}
{['grammar','vocabulary','listening','podcast'].includes(kind)&&<section class="finish-learning"><h2>Keep your progress</h2><label class="checkline"><input type="checkbox" data-reviewed={id}/> I have reviewed this lesson's learning content</label><p class="muted">Submit its selected check as well to complete the learning entry. A low score recommends revision without blocking the next lesson.</p></section>}
<section class="next-links"><h2>Continue your unit</h2><a href="/a2/unit-1/">Choose a learning section</a><a href="/a2/unit-1/revision/">Revision and mistake review</a><a href="/a2/unit-1/review/">Integrated unit review</a></section>
<details class="source-info"><summary>About this unit</summary><p>A2 Unit 1 · English-supported learning · Content version BD-A2-W01.1. The project owner has reviewed the materials and approved their publication. The 178 recordings have owner-attested listening approval dated 29 October 2026.</p><p>Owner-approved Unit 1 exceptions: 80.707-second review recording; 349.326-second podcast; prior-A1 and within-unit retrieval arrangement. The earlier-A2-unit retrieval requirement begins with Unit 2.</p></details>
</main><footer><p>Be Deutsch · Learn a little. Say a little more.</p><p>No account, analytics or cloud progress · A1 and A2 progress stay separate.</p><p><a href="/privacy/" style="color:inherit">Privacy</a> · <a href="/impressum/" style="color:inherit">Legal notice</a> · <a href="/support/" style="color:inherit">Support</a></p></footer>
<script>import '../../../a2/scripts/app';</script>
</body></html>
