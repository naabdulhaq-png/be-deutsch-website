---
import { site } from '../../config/site';
import course from '../../a2/data/integrated-course.json';
import '../../a2/styles/a2.css';
import '../../a2/styles/bd-ui-08.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="index,follow,max-image-preview:large"/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="description" content="Learn A2 German across ten connected units with vocabulary, grammar, listening, podcasts, practice and revision."/><title>Complete A2 German course · Be Deutsch</title><link rel="canonical" href={new URL(Astro.url.pathname, site.url).href}/><link rel="icon" href="/favicon.svg"/></head><body class="bd08-overview-body"><a class="skip-link" href="#main">Skip to course</a><header class="bd08-overview-header"><a href="/" class="bd08-brand">🇩🇪 <strong>Be Deutsch</strong></a><div><span>Complete A2 German course</span><h1>Ten units. One connected learning journey.</h1><p>Build practical A2 German through connected vocabulary, grammar, listening, podcasts, practice and revision.</p></div><a class="button" href="/a2/unit-1/">Start Unit 1</a></header><main id="main" class="bd08-overview-main"><section class="bd08-stats" aria-label="Course inventory"><div><strong>300</strong><span>Vocabulary records</span></div><div><strong>40</strong><span>Grammar lessons</span></div><div><strong>384</strong><span>Practice activities</span></div><div><strong>24</strong><span>Listening passages</span></div><div><strong>5</strong><span>Podcasts</span></div></section><section class="bd08-unit-grid">{course.units.map(unit => <article class:list={['bd08-unit-card', unit.unit === 1 && 'is-approved']}><header><span>A2 · Unit {unit.unit}</span><b>Course unit</b></header><h2>{unit.title}</h2><p>{unit.purpose}</p><ul><li>{unit.vocabulary_lessons.length} Vocabulary lessons</li><li>{unit.grammar_lessons.length} Grammar lessons</li><li>{unit.listening_lessons.reduce((n, x) => n + x.passage_count, 0) || 4} Listening passages</li>{unit.podcast_episodes.length > 0 && <li>{unit.podcast_episodes.length} Podcast episode</li>}</ul><a class="button" href={`/a2/unit-${unit.unit}/`}>Open Unit {unit.unit} →</a></article>)}</section></main><footer><p>Be Deutsch · Complete A2 German course</p></footer></body></html>
