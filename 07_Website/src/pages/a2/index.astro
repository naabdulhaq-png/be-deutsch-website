---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import course from '../../a2/data/integrated-course.json';
---
<BaseLayout title="Complete A2 German course · Be Deutsch" description="Learn A2 German across ten connected units with vocabulary, grammar, listening, podcasts, practice and revision.">
 <div id="top"></div><SiteHeader/>
 <main id="main-content" class="d3-a2-overview">
  <section class="d3-a2-hero"><div class="container"><p class="d3-kicker">A2 Complete Course</p><h1>Ten units. One connected<br/><span>learning journey.</span></h1><p>Build practical A2 German through the approved vocabulary, grammar, listening, podcasts, practice and revision.</p><a class="d3-button d3-button--orange" href="/a2/unit-1/">Start Unit 1 →</a></div></section>
  <section class="container d3-a2-stats" aria-label="Course inventory"><div><strong>300</strong><span>Vocabulary records</span></div><div><strong>40</strong><span>Grammar topics</span></div><div><strong>384</strong><span>Activities</span></div><div><strong>24</strong><span>Listening passages</span></div><div><strong>5</strong><span>Podcast episodes</span></div></section>
  <section class="container d3-a2-units" aria-labelledby="units-title"><div class="d3-section-head"><p class="d3-kicker">Course map</p><h2 id="units-title">All ten units, easy to find.</h2><p>Each unit keeps the same shared navigation, progress, lesson cards, audio controls and assessment patterns.</p></div><div class="d3-a2-grid">{course.units.map(unit=><article class="d3-a2-card"><header><span>A2 · Unit {unit.unit}</span><b>{String(unit.unit).padStart(2,'0')}</b></header><h3>{unit.title}</h3><p>{unit.purpose}</p><ul><li>{unit.vocabulary_lessons.length} vocabulary lessons</li><li>{unit.grammar_lessons.length} grammar lessons</li><li>{unit.listening_lessons.reduce((n,x)=>n+x.passage_count,0)||4} listening passages</li>{unit.podcast_episodes.length>0&&<li>{unit.podcast_episodes.length} podcast episode</li>}</ul><a class="d3-button" href={`/a2/unit-${unit.unit}/`}>Open Unit {unit.unit} →</a></article>)}</div></section>
 </main><SiteFooter/>
</BaseLayout>
<style>
 .d3-a2-overview{background:#F8FBF9}.d3-a2-hero{padding:clamp(4rem,8vw,7rem) 0;background:radial-gradient(circle at 85% 30%,rgba(255,122,0,.16),transparent 25%),linear-gradient(125deg,var(--bd-cream),var(--bd-mint))}.d3-a2-hero h1{margin:.3rem 0 1rem;font-size:clamp(3rem,7vw,6rem);line-height:.98;letter-spacing:-.06em}.d3-a2-hero h1 span{color:var(--bd-orange-control)}.d3-a2-hero>div>p:not(.d3-kicker){max-width:47rem;color:var(--bd-muted);font-size:1.1rem;line-height:1.7}.d3-a2-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem;margin-top:-2rem;padding:0 0 4rem}.d3-a2-stats div{display:grid;gap:.2rem;padding:1.2rem;border:1px solid var(--bd-line);border-radius:1rem;background:#fff;box-shadow:var(--shadow-soft)}.d3-a2-stats strong{font-size:1.65rem;color:var(--bd-emerald)}.d3-a2-stats span{font-size:.72rem;color:var(--bd-muted)}.d3-a2-units{padding-bottom:5rem}.d3-a2-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.d3-a2-card{display:flex;flex-direction:column;padding:1.3rem;border:1px solid var(--bd-line);border-radius:1.2rem;background:white;box-shadow:0 6px 18px rgba(15,23,42,.05)}.d3-a2-card header{display:flex;justify-content:space-between;align-items:center;color:var(--bd-emerald);font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.d3-a2-card header b{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--bd-orange-control);color:white}.d3-a2-card h3{font-size:1.25rem;margin:1rem 0 .4rem}.d3-a2-card p,.d3-a2-card li{color:var(--bd-muted);font-size:.8rem;line-height:1.55}.d3-a2-card ul{padding-left:1.1rem;margin:0 0 1rem}.d3-a2-card .d3-button{margin-top:auto;align-self:flex-start;font-size:.8rem;min-height:44px}@media(max-width:900px){.d3-a2-stats{grid-template-columns:repeat(2,1fr)}.d3-a2-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.d3-a2-stats,.d3-a2-grid{grid-template-columns:1fr}.d3-a2-stats{margin-top:0;padding-top:1rem}.d3-a2-hero h1{font-size:3rem}}
</style>
